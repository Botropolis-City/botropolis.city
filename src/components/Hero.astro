---
import { getImage, Picture } from "astro:assets";
import { clip, duration, image, media } from "../data/catalog.ts";
import { heroMedia } from "../data/hero.ts";
import Keycap from "./Keycap.astro";

const tour = clip("workshop/tour");
const hero = heroMedia(media);
const alt =
  "An isometric city of a dozen districts on its island: towers, a plaza with a fountain, two radio towers on the ridge, the depot's crates, and boats on the river.";
const poster = hero.kind === "loop" ? await getImage({ src: image(hero.poster), width: 1920, format: "webp" }) : undefined;
---

<section class="hero" id="top" data-hero>
  <div class="city">
    {
      hero.kind === "loop" ? (
        <video autoplay muted loop playsinline preload="auto" poster={poster!.src} aria-label={alt} data-testid="hero-media" data-hero-loop>
          {hero.sources.map((s) => (
            <source src={s.url} type={s.type} media={s.media} />
          ))}
        </video>
      ) : (
        <Picture
          src={image(hero.image)}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="(max-width: 900px) 120vw, 80vw"
          alt={alt}
          loading="eager"
          fetchpriority="high"
          data-testid="hero-media"
        />
      )
    }
  </div>
  <div class="wrap copy">
    <p class="eyebrow"><span class="dot" style="--tone:var(--needs-you)"></span> a city for your Claude Code sessions</p>
    <h1>Botropolis</h1>
    <p class="lede">Every Claude Code session on your machine, drawn as a city, and driven from it.</p>
    <p class="sub">
      Districts are projects, and a project is just a directory. Buildings are sessions, one to five storeys by how much work each has done, and their beacons say which one needs
      you. Click one to attach it, stop it, read it or pack it away; the terminal is only ever a view.
    </p>
    <p class="news">
      <a href="#new"><b>New in {media.version}</b> a frame in about 10–11 ms and about 445 MiB settled, on a laptop's integrated graphics; under 1% of a core while hidden →</a>
    </p>
    <div class="actions">
      <a class="btn primary" href="#install">Install <span class="kbd"><Keycap k="i" /></span></a>
      <a class="btn" href="#watch" data-play="workshop">▶ Watch the tour <span class="kbd">{duration(tour.seconds)}</span></a>
      <a class="btn" href="https://github.com/Botropolis-City/botropolis">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path></svg
        >
        GitHub
      </a>
    </div>
  </div>
  <button class="pause" type="button" aria-pressed="false" data-pause>
    <span class="when-playing">❚❚ Pause</span><span class="when-paused">▶ Play</span>
    <span class="sr-only">the drifting city</span>
  </button>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const button = hero.querySelector<HTMLButtonElement>("[data-pause]")!;
  const loop = hero.querySelector<HTMLVideoElement>("[data-hero-loop]");
  if (loop && matchMedia("(prefers-reduced-motion: reduce)").matches) {
    loop.removeAttribute("autoplay");
    loop.pause();
    hero.classList.add("paused");
    button.setAttribute("aria-pressed", "true");
  }
  button.addEventListener("click", () => {
    const paused = hero.classList.toggle("paused");
    button.setAttribute("aria-pressed", String(paused));
    if (loop && paused) loop.pause();
    else if (loop) void loop.play();
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--bar-h));
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .city {
    position: absolute;
    z-index: -2;
    top: 50%;
    right: -6vw;
    width: min(1500px, 72vw);
    translate: 0 -50%;
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 78%, transparent 100%);
  }
  .city :global(img) {
    width: 100%;
    animation: drift 48s ease-in-out infinite alternate;
    transform-origin: 60% 50%;
  }
  .hero.paused .city :global(img) {
    animation-play-state: paused;
  }
  .city video {
    display: block;
    width: 100%;
  }
  @keyframes drift {
    from {
      transform: scale(1) translate(0, 0);
    }
    to {
      transform: scale(1.12) translate(-3%, 2%);
    }
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, var(--bg) 0%, var(--bg) 34%, rgb(18 20 26 / 0.85) 44%, rgb(18 20 26 / 0.3) 56%, transparent 66%);
  }
  .copy {
    width: 100%;
    padding-top: 64px;
    padding-bottom: 96px;
  }
  .copy > * {
    max-width: 36rem;
  }
  h1 {
    margin: 0 0 20px;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 750;
  }
  .lede {
    margin: 0 0 16px;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .sub {
    margin: 0 0 20px;
    color: var(--dim);
    text-wrap: pretty;
  }
  .news {
    margin: 0 0 32px;
    font-size: 15px;
  }
  .news a {
    display: inline-block;
    padding: 8px 12px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--dim);
    text-decoration: none;
  }
  .news a:hover {
    color: var(--text);
  }
  .news b {
    margin-right: 6px;
    color: var(--working);
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .pause {
    position: absolute;
    right: var(--gutter);
    bottom: 24px;
    padding: 6px 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--dim);
    font: 500 12px/1 var(--mono);
    cursor: pointer;
  }
  .pause:hover {
    color: var(--text);
  }
  .when-paused,
  .paused .when-playing {
    display: none;
  }
  .paused .when-paused {
    display: inline;
  }
  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
    }
    .city {
      position: relative;
      top: auto;
      right: auto;
      translate: none;
      width: 116%;
      margin: 12px -8% 0;
    }
    .hero::before {
      background: linear-gradient(0deg, var(--bg) 0%, transparent 45%);
    }
    .copy {
      padding-top: 0;
      padding-bottom: 72px;
    }
    .pause {
      top: 12px;
      bottom: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .city :global(img) {
      animation: none;
    }
    .pause {
      display: none;
    }
  }
</style>
