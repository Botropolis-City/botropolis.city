---
import { latest } from "../data/current.ts";

const links = [
  { href: "#watch", label: "watch", tone: "var(--working)" },
  { href: "#views", label: "views", tone: "var(--unattended)" },
  { href: "#drive", label: "drive", tone: "var(--needs-you)" },
  { href: "#new", label: "new", tone: "var(--working)" },
  { href: "#install", label: "install", tone: "var(--merged)" },
  { href: "https://github.com/Botropolis-City/botropolis", label: "github", tone: "var(--resting)" },
];
---

<header class="hud">
  <a class="mark" href="#top" aria-label="Botropolis, back to the top">
    <img src="/favicon.svg" alt="" width="18" height="18" />
    <span>botropolis</span>
  </a>
  <nav aria-label="Sections">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href}>
              <span class="dot" style={`--tone:${l.tone}`} />
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a class="version" data-testid="version" href={latest.url}>v{latest.version}</a>
</header>

<style>
  .hud {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 20px;
    height: var(--bar-h);
    padding: 0 var(--gutter);
    background: rgb(13 15 21 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--hairline);
    font-size: 14px;
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    text-decoration: none;
  }
  nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  ul {
    display: flex;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: #fff;
  }
  .version {
    font: 500 12px/1 var(--mono);
    color: var(--dim);
    padding: 4px 8px;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    text-decoration: none;
  }
  @media (max-width: 560px) {
    .mark span {
      display: none;
    }
    .hud {
      gap: 14px;
    }
    ul {
      gap: 14px;
    }
  }
</style>
