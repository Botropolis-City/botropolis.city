---
import Keycap from "./Keycap.astro";

const keys = [
  ["j / k", "next and previous scene"],
  ["v / ⇧v", "next and previous view"],
  ["w", "watch"],
  ["e", "views"],
  ["i", "install"],
  ["g", "GitHub"],
  ["?", "this list"],
];
---

<dialog aria-labelledby="keys-title" data-keys>
  <h2 id="keys-title">Keys</h2>
  <dl>
    {
      keys.map(([k, what]) => (
        <>
          <dt>
            <Keycap k={k} />
          </dt>
          <dd>{what}</dd>
        </>
      ))
    }
  </dl>
  <label><input type="checkbox" data-keys-toggle checked /> Keyboard shortcuts</label>
  <p>Single-key shortcuts can get in the way of speech input and some assistive tech; switch them off here and they stay off.</p>
  <form method="dialog"><button class="btn">Close <Keycap k="esc" /></button></form>
</dialog>

<script>
  import { loadEnabled, saveEnabled, shouldHandle } from "../scripts/keys.ts";

  const dialog = document.querySelector<HTMLDialogElement>("[data-keys]")!;
  const toggle = dialog.querySelector<HTMLInputElement>("[data-keys-toggle]")!;
  let enabled = loadEnabled(localStorage);
  toggle.checked = enabled;

  toggle.addEventListener("change", () => {
    enabled = toggle.checked;
    saveEnabled(localStorage, enabled);
  });

  document.querySelectorAll("[data-keys-open]").forEach((b) => b.addEventListener("click", () => dialog.showModal()));

  document.addEventListener("keydown", (e) => {
    if (dialog.open || !shouldHandle(e, enabled)) return;
    if (e.key === "?") {
      e.preventDefault();
      dialog.showModal();
      return;
    }
    const target = document.querySelector<HTMLElement>(`[data-key="${CSS.escape(e.key)}"]`);
    if (!target) return;
    e.preventDefault();
    target.click();
  });
</script>

<style>
  dialog {
    width: min(420px, calc(100vw - 32px));
    padding: 24px;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: var(--panel-solid);
    color: var(--text);
  }
  dialog::backdrop {
    background: rgb(5 6 10 / 0.6);
    backdrop-filter: blur(2px);
  }
  h2 {
    font-size: 1.3rem;
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 10px 16px;
    align-items: center;
    margin: 16px 0 20px;
  }
  dd {
    margin: 0;
    color: var(--dim);
  }
  label {
    display: flex;
    gap: 10px;
    align-items: center;
    font-weight: 500;
  }
  input {
    accent-color: var(--accent);
    width: 16px;
    height: 16px;
  }
  p {
    margin: 8px 0 20px;
    color: var(--dim);
    font-size: 14px;
  }
</style>
