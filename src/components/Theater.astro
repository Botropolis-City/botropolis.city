---
import { getImage, Picture } from "astro:assets";
import { clip, duration, image } from "../data/catalog.ts";
import AppWindow from "./AppWindow.astro";
import Keycap from "./Keycap.astro";
import { theater } from "../data/theater.ts";
import { media } from "../data/catalog.ts";

const scenes = await Promise.all(
  theater.map(async (id) => {
    const c = clip(id);
    const poster = await getImage({ src: image(c.poster), width: 1280, format: "webp" });
    return { ...c, posterUrl: poster.src };
  }),
);
const first = scenes[0];
---

<section class="band" id="watch" aria-labelledby="watch-title">
  <div class="wrap">
    <p class="eyebrow"><span class="dot" style="--tone:var(--working)"></span> watch</p>
    <h2 id="watch-title">Scene select</h2>
    <p class="lead">Six cities filmed in v{media.version} from demo sessions, with the interface as you would see it. Pick one, or step through them.</p>

    <div class="stage" data-theater>
      <div class="screen">
        <AppWindow title={`botropolis — ${first.scenario}`} titleId="window-title">
          <video
            data-testid="player"
            muted
            playsinline
            controls
            loop
            preload="none"
            poster={first.posterUrl}
            width={first.width}
            height={first.height}
          >
            {first.sources.map((s) => <source src={s.url} type={s.type} />)}
          </video>
        </AppWindow>
        <p class="caption" data-testid="caption" aria-live="polite">
          <strong>{first.title}.</strong>
          {first.description}
        </p>
      </div>

      <div class="rail">
        <div class="rail-head">
          <span>scenes</span>
          <span class="step">
            <button type="button" data-step="-1" data-key="k" aria-label="Previous scene"><Keycap k="k" /></button>
            <button type="button" data-step="1" data-key="j" aria-label="Next scene"><Keycap k="j" /></button>
          </span>
        </div>
        <ol>
          {
            scenes.map((s, i) => (
              <li>
                <button
                  type="button"
                  class="scene"
                  aria-pressed={i === 0 ? "true" : "false"}
                  data-testid={`scene-${s.scenario}`}
                  data-scene={JSON.stringify({ scenario: s.scenario, title: s.title, description: s.description, poster: s.posterUrl, sources: s.sources.map(({ url, type }) => ({ url, type })) })}
                >
                  <Picture src={image(s.poster)} formats={["avif"]} fallbackFormat="webp" widths={[240, 480]} sizes="160px" alt="" loading="lazy" />
                  <span class="meta">
                    <span class="name">{s.title}</span>
                    <span class="sub">
                      {s.scenario} · {duration(s.seconds)}
                    </span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import { step } from "../scripts/cycle.ts";

  interface Scene {
    scenario: string;
    title: string;
    description: string;
    poster: string;
    sources: { url: string; type: string }[];
  }

  const root = document.querySelector<HTMLElement>("[data-theater]")!;
  const player = root.querySelector<HTMLVideoElement>("video")!;
  const caption = root.querySelector<HTMLElement>("[data-testid=caption]")!;
  const title = root.querySelector<HTMLElement>("[data-testid=window-title]")!;
  const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-scene]")];
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches || (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  let current = 0;

  function show(i: number, play: boolean) {
    current = i;
    const s: Scene = JSON.parse(buttons[i].dataset.scene!);
    buttons.forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
    player.replaceChildren(
      ...s.sources.map((src) => Object.assign(document.createElement("source"), { src: src.url, type: src.type })),
    );
    player.poster = s.poster;
    player.load();
    title.textContent = `botropolis — ${s.scenario}`;
    caption.replaceChildren(Object.assign(document.createElement("strong"), { textContent: `${s.title}.` }), ` ${s.description}`);
    if (play) player.play().catch(() => {});
  }

  buttons.forEach((b, i) => b.addEventListener("click", () => show(i, true)));
  root.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
    b.addEventListener("click", () => show(step(current, Number(b.dataset.step), buttons.length), true)),
  );

  document.querySelectorAll<HTMLAnchorElement>("[data-play]").forEach((a) =>
    a.addEventListener("click", () => {
      const i = buttons.findIndex((b) => JSON.parse(b.dataset.scene!).scenario === a.dataset.play);
      if (i >= 0) show(i, true);
    }),
  );

  if (!calm) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) player.play().catch(() => {});
        else player.pause();
      },
      { threshold: 0.5 },
    ).observe(player);
  }
</script>

<style>
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 24px;
    align-items: start;
  }
  .caption {
    margin: 14px 2px 0;
    color: var(--dim);
    font-size: 15px;
  }
  .caption :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .rail,
  .screen {
    min-width: 0;
  }
  .rail-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 10px;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .step {
    display: flex;
    gap: 6px;
  }
  .step button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  ol {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .scene {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    align-items: center;
    width: 100%;
    padding: 6px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--text);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .scene:hover {
    background: var(--raised);
  }
  .scene[aria-pressed="true"] {
    border-color: rgb(232 160 60 / 0.6);
    background: rgb(232 160 60 / 0.07);
  }
  .scene :global(img) {
    width: 96px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--hairline);
  }
  .meta {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .name {
    font-size: 14px;
    font-weight: 550;
    line-height: 1.3;
  }
  .sub {
    font: 400 12px/1.3 var(--mono);
    color: var(--dim);
  }
  @media (max-width: 960px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
    }
    ol {
      grid-auto-flow: column;
      grid-auto-columns: 220px;
      overflow-x: auto;
      padding-bottom: 6px;
      scroll-snap-type: x mandatory;
    }
    li {
      scroll-snap-align: start;
    }
  }
</style>
