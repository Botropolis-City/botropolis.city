---
interface Props {
  k: string;
}
const { k } = Astro.props;
---

<kbd class="keycap">{k}</kbd>

<style>
  .keycap {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 4px;
    background: #30333b;
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.35);
    color: var(--text);
    font: 500 12px/1 var(--mono);
  }
</style>
