---
import { release } from "../data/release.ts";
import Keycap from "./Keycap.astro";

const repo = "https://github.com/Botropolis-City/botropolis/blob/main";
---

<section class="band" id="new" aria-labelledby="new-title">
  <div class="wrap">
    <p class="eyebrow"><span class="dot" style="--tone:var(--working)"></span> new in {release.version}</p>
    <h2 id="new-title">A tenth of the drawing, about half the memory</h2>
    <p class="lead">
      {release.version} is a performance release. Hidden, it takes under 1% of a core, and so does the daemon once it settles; the first launch no longer takes the machine.
      <span class="measured">{release.measuredOn}, against 0.2.2 and the first builds of this release:</span>
    </p>

    <div class="table">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Measure</span></th>
            <th scope="col">before</th>
            <th scope="col">{release.version}</th>
          </tr>
        </thead>
        <tbody>
          {
            release.figures.map((f) => (
              <tr>
                <th scope="row">{f.label}</th>
                <td>{f.before}</td>
                <td class="now">{f.after}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="misses">
      <h3>Still missed</h3>
      <p>Two budgets, and 0.3.x continues on them:</p>
      <ul>{release.misses.map((m) => <li>{m.text}</li>)}</ul>
    </div>

    <div class="cards">
      <article>
        <h3>Post your city <Keycap k="⇧s" /></h3>
        <p>
          Sharing mode hides what identifies you: session titles, project and district names, prompts, spend and token figures, and every panel that shows them. The city wears neutral
          names such as District A and Session 3. Then <Keycap k="p" /> saves a picture, <Keycap k="g" /> a four-second GIF and <Keycap k="c" /> a clip of 5 to 60 seconds, and
          <Keycap k="esc" /> brings everything back.
        </p>
      </article>
      <article>
        <h3>Read a session in the city <Keycap k="o" /></h3>
        <p>The reading pane shows Claude's replies as formatted text, not raw Markdown: bold is bold, code and tables are set in Go Mono, and a link shows its URL after its text.</p>
      </article>
      <article>
        <h3>Manual pages, and a promise</h3>
        <p>
          <code>man botropolis</code>, a page per command, and <code>man botropolis-config</code> for every setting with its default.{" "}
          <a href={`${repo}/docs/compatibility.md`}>docs/compatibility.md</a> says what 1.0.0 promises not to break: every command and flag <code>--help</code> shows, every config key,
          every data file an earlier version wrote.
        </p>
      </article>
    </div>

    <p class="more">
      Commands moved too, and the daemon needs a restart after upgrading: <a href="#install">see install</a>. Everything else is in{" "}
      <a href={`${repo}/CHANGELOG.md`}>the changelog</a>.
    </p>
  </div>
</section>

<style>
  .measured {
    display: block;
    margin-top: 12px;
    font-size: 15px;
  }
  .table {
    max-width: 52rem;
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: var(--panel-solid);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  th,
  td {
    padding: 12px 18px;
    text-align: left;
    vertical-align: baseline;
  }
  thead th {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    border-bottom: 1px solid var(--hairline);
    background: var(--bar);
  }
  tbody tr + tr > * {
    border-top: 1px solid var(--hairline);
  }
  tbody th {
    font-weight: 550;
  }
  td {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 14px;
  }
  td.now {
    color: var(--working);
  }
  .misses {
    max-width: 52rem;
    margin-top: 20px;
    color: var(--dim);
    font-size: 15px;
  }
  .misses h3 {
    display: inline;
    margin: 0 8px 0 0;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .misses p {
    display: inline;
  }
  .misses ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 56px;
  }
  article {
    padding: 22px 24px;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: var(--raised);
  }
  article h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 10px;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  article p {
    margin: 0;
    color: var(--dim);
    font-size: 15px;
  }
  code {
    color: var(--text);
    font: 0.92em var(--mono);
  }
  article a,
  .more a {
    color: var(--accent);
  }
  .more {
    margin: 32px 0 0;
    color: var(--dim);
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
