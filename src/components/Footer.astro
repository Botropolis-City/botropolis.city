---
import Keycap from "./Keycap.astro";
---

<footer>
  <div class="bar" aria-label="Keys">
    <a href="https://github.com/Botropolis-City/botropolis" data-key="g"><Keycap k="g" /> github</a>
    <a href="#watch" data-key="w"><Keycap k="w" /> watch</a>
    <a href="#views" data-key="e"><Keycap k="e" /> views</a>
    <a href="#install" data-key="i"><Keycap k="i" /> install</a>
    <button type="button" data-keys-open><Keycap k="?" /> keys</button>
  </div>
  <div class="small">
    <p class="credits" data-testid="credits">
      Roads, trees, vehicles, trains, boats and landmarks by <a href="https://kenney.nl">Kenney</a> (kenney.nl), CC0 — <a href="https://kenney.nl/donate">thank you</a>.
      Session buildings, the drone, the fountain and the building sites are modelled for Botropolis.
      Set in Inter by The Inter Project Authors and JetBrains Mono by The JetBrains Mono Project Authors (SIL OFL 1.1).
    </p>
    <span>
      Botropolis is MIT licensed and not affiliated with Anthropic. <a href="https://github.com/Botropolis-City/botropolis/blob/main/CHANGELOG.md">Changelog</a> ·{" "}
      <a href="https://github.com/Botropolis-City/botropolis/blob/main/docs/compatibility.md">what 1.0.0 keeps</a>
    </span>
    <a href="mailto:hello@botropolis.city">hello@botropolis.city</a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--hairline);
    background: var(--bar);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    padding: 14px var(--gutter);
    font-size: 13px;
    color: var(--dim);
  }
  .bar a,
  .bar button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .bar a:hover,
  .bar button:hover {
    color: var(--text);
  }
  .small {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 12px var(--gutter) 20px;
    border-top: 1px solid var(--hairline);
    color: var(--dim);
    font-size: 13px;
  }
  .credits {
    flex-basis: 100%;
    margin: 0;
    max-width: 72ch;
    line-height: 1.5;
  }
</style>
