---
import { Picture } from "astro:assets";
import { image, still } from "../data/catalog.ts";
import { keys, menus } from "../data/drive.ts";
import AppWindow from "./AppWindow.astro";
import Keycap from "./Keycap.astro";

const needs = still("workshop/needs-you");
const power = still("workshop/power");
---

<section class="band" id="drive" aria-labelledby="drive-title">
  <div class="wrap">
    <p class="eyebrow"><span class="dot" style="--tone:var(--needs-you)"></span> drive</p>
    <h2 id="drive-title">Then drive it from the map</h2>
    <p class="lead">
      Sessions live in Claude Code's own background daemon. Botropolis starts them, opens them in a terminal, stops them and resumes them, and never writes to <code>~/.claude</code> itself. Close the terminal and the session carries on.
    </p>

    <div class="row">
      <AppWindow title="botropolis — workshop">
        <Picture src={image(needs.image)} formats={["avif"]} fallbackFormat="webp" widths={[640, 960, 1280, 1920]} sizes="(max-width: 960px) 100vw, 760px" alt={needs.description} loading="lazy" />
      </AppWindow>
      <div class="text">
        <h3>{needs.title}</h3>
        <p><Keycap k="tab" /> jumps to the next session waiting on an answer and opens its card. <Keycap k="enter" /> runs the card's first button.</p>
        <p>
          The card's actions are one direct verb and three menus, <b>Session ⌄</b>, <b>Project ⌄</b> and <b>Group ⌄</b>. A menu lists each row with the key that runs it, and a
          verb that does not apply is absent rather than greyed.
        </p>
        <div class="menus">
          {
            menus.map((m) => (
              <div>
                <h4><Keycap k={m.key} /> {m.name}</h4>
                <ul class="chips" aria-label={`${m.name} menu`}>
                  {m.rows.map((r) => (
                    <li><kbd>{r.key}</kbd> {r.label}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="note">
          <b>read</b> opens the conversation inside the city, formatted. A card leads with the recap Claude Code writes when a session is left waiting; asking for a fresh one
          with <b>generate summary</b> is the only thing on the map that spends tokens, and only when you press it.
        </p>
      </div>
    </div>

    <div class="keys" aria-labelledby="keys-title">
      <h3 id="keys-title">The keys</h3>
      <ul>
        {
          keys.map((k) => (
            <li>
              {!k.bare && <span class="caps">{k.caps.map((c) => <Keycap k={c} />)}</span>}
              <span>{k.line}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="row flip">
      <AppWindow title="botropolis — power plant">
        <Picture src={image(power.image)} formats={["avif"]} fallbackFormat="webp" widths={[640, 960, 1280, 1920]} sizes="(max-width: 960px) 100vw, 760px" alt={power.description} loading="lazy" />
      </AppWindow>
      <div class="text">
        <h3>{power.title}</h3>
        <p>Click the power plant for the breakdown by model, project and session over an hour, a day or a week. Its wires carry each session's live token rate.</p>
        <p class="note">Costs are estimates, which is why they carry a ~.</p>
      </div>
    </div>
  </div>
</section>

<style>
  code {
    font: 0.92em var(--mono);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .row + .row,
  .keys + .row {
    margin-top: 72px;
  }
  .flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
  }
  .flip > :global(:first-child) {
    order: 2;
  }
  h3 {
    margin: 0 0 12px;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .text p {
    margin: 0 0 16px;
  }
  .note {
    color: var(--dim);
    font-size: 15px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menus {
    display: grid;
    gap: 12px;
    margin: 0 0 18px;
  }
  h4 {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 0 0 6px;
    font-size: 14px;
  }
  .chips kbd {
    color: var(--dim);
    font: 500 12px/1 var(--mono);
  }
  .keys {
    margin-top: 56px;
  }
  .keys ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 14px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .keys li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    color: var(--dim);
    font-size: 15px;
  }
  .caps {
    display: inline-flex;
    flex: none;
    gap: 4px;
  }
  .chips li {
    padding: 5px 9px;
    border-radius: 4px;
    background: #2a2d34;
    color: var(--accent);
    font: 500 13px/1 var(--font);
  }
  @media (max-width: 960px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .flip > :global(:first-child) {
      order: 0;
    }
  }
</style>
