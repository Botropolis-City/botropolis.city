---
import { getImage, Picture } from "astro:assets";
import { image, media } from "../data/catalog.ts";
import { cards, facts } from "../data/groups.ts";
import AppWindow from "./AppWindow.astro";
import Shot from "./Shot.astro";

const shown = await Promise.all(
  cards.map(async (c) => {
    const items = c.facts.map((id) => facts.find((f) => f.id === id)!);
    const forms = c.forms
      ? await Promise.all(
          c.forms.map(async (f) => {
            const s = media.stills.find((x) => x.id === f.media)!;
            const whole = await getImage({ src: image(s.image), width: 1920, format: "webp" });
            return { ...f, still: s, whole: whole.src };
          }),
        )
      : undefined;
    return { ...c, items, forms };
  }),
);
---

<section class="band" id="groups" aria-labelledby="groups-title">
  <div class="wrap">
    <p class="eyebrow"><span class="dot" style="--tone:var(--working)"></span> groups</p>
    <h2 id="groups-title">Work that belongs together, kept together</h2>
    <p class="lead">
      A group is the sessions working on one thing, however many projects it crosses. The city finds them, and you can make, rename, move and close them from the map.
    </p>

    <div class="cards">
      {
        shown.map((c) => (
          <article class:list={["card", c.forms && "wide", !c.media && !c.forms && "plain"]}>
            {c.media && (
              <AppWindow title={`botropolis — ${c.media.split("/")[0]}`}>
                <Shot id={c.media} poster={c.poster} sizes="(max-width: 960px) 100vw, 600px" />
              </AppWindow>
            )}
            {c.forms && (
              <div class="forms" data-forms>
                <div class="picks" role="group" aria-label="group_line_form">
                  {c.forms.map((f, i) => (
                    <button type="button" data-form-pick={f.value} aria-pressed={i === 0 ? "true" : "false"}>
                      {f.value}
                      {i === 0 && <span class="default">default</span>}
                    </button>
                  ))}
                </div>
                {c.forms.map((f, i) => (
                  <figure data-form={f.value} hidden={i !== 0}>
                    <AppWindow title={`botropolis — group_line_form = ${f.value}`}>
                      <Picture
                        src={image(f.still.detail!.image)}
                        formats={["avif"]}
                        fallbackFormat="webp"
                        widths={[450, 900]}
                        sizes="(max-width: 960px) 100vw, 900px"
                        alt={f.still.description}
                        loading="lazy"
                      />
                    </AppWindow>
                    <figcaption>
                      {f.still.title}. <a data-whole href={f.whole}>See the whole city</a>
                    </figcaption>
                  </figure>
                ))}
              </div>
            )}
            <dl>
              {c.items.map((f) => (
                <>
                  <dt>{f.title}</dt>
                  <dd>{f.line}</dd>
                </>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-forms]")) {
    const picks = [...box.querySelectorAll<HTMLButtonElement>("[data-form-pick]")];
    const panels = [...box.querySelectorAll<HTMLElement>("[data-form]")];
    for (const pick of picks) {
      pick.addEventListener("click", () => {
        for (const p of picks) p.setAttribute("aria-pressed", String(p === pick));
        for (const panel of panels) panel.hidden = panel.dataset.form !== pick.dataset.formPick;
      });
    }
  }
</script>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 40px;
    align-items: start;
  }
  .wide {
    grid-column: 1 / -1;
  }
  .card > :global(.window),
  .forms {
    margin-bottom: 16px;
  }
  .plain {
    align-self: center;
  }
  .picks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .picks button {
    padding: 6px 12px;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    background: none;
    color: var(--dim);
    font: 500 13px/1 var(--mono);
    cursor: pointer;
  }
  .picks button[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--text);
  }
  .default {
    margin-left: 6px;
    color: var(--dim);
    font-size: 11px;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 10px;
    color: var(--dim);
    font-size: 15px;
  }
  dl {
    margin: 0;
  }
  dt {
    margin-top: 12px;
    font-weight: 600;
    font-size: 15px;
  }
  dt:first-child {
    margin-top: 0;
  }
  dd {
    margin: 2px 0 0;
    color: var(--dim);
    font-size: 15px;
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
