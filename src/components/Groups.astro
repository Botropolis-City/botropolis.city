---
import { getImage, Picture } from "astro:assets";
import { clip, image, still } from "../data/catalog.ts";
import { facts, rows } from "../data/groups.ts";
import AppWindow from "./AppWindow.astro";

const shown = await Promise.all(
  rows.map(async (r) => {
    const items = r.facts.map((id) => facts.find((f) => f.id === id)!);
    if (r.kind === "still") {
      const s = still(r.media);
      return { ...r, items, scenario: r.media.split("/")[0], still: s };
    }
    const c = clip(r.media);
    const poster = await getImage({ src: image(c.poster), width: 1280, format: "webp" });
    return { ...r, items, scenario: r.media.split("/")[0], clip: c, posterUrl: poster.src };
  }),
);
---

<section class="band" id="groups" aria-labelledby="groups-title">
  <div class="wrap">
    <p class="eyebrow"><span class="dot" style="--tone:var(--working)"></span> groups</p>
    <h2 id="groups-title">Work that belongs together, kept together</h2>
    <p class="lead">
      A group is the sessions working on one thing, however many projects it crosses. The city finds them, and you can make, rename, move and close them from the map.
    </p>

    {
      shown.map((r, i) => (
        <div class:list={["row", i % 2 === 1 && "flip"]}>
          <AppWindow title={`botropolis — ${r.scenario}`}>
            {"still" in r ? (
              <Picture
                src={image(r.still.image)}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[640, 960, 1280, 1920]}
                sizes="(max-width: 960px) 100vw, 760px"
                alt={r.still.description}
                loading="lazy"
              />
            ) : (
              <video data-clip={r.media} muted playsinline controls loop preload="none" poster={r.posterUrl} width={r.clip.width} height={r.clip.height} aria-label={r.clip.description}>
                {r.clip.sources.map((s) => (
                  <source src={s.url} type={s.type} />
                ))}
              </video>
            )}
          </AppWindow>
          <div class="text">
            <h3>{r.title}</h3>
            <dl>
              {r.items.map((f) => (
                <>
                  <dt>{f.title}</dt>
                  <dd>{f.line}</dd>
                </>
              ))}
            </dl>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .row + .row {
    margin-top: 72px;
  }
  .flip > :first-child {
    order: 2;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
  }
  h3 {
    margin: 0 0 12px;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  dl {
    margin: 0;
  }
  dt {
    margin-top: 12px;
    font-weight: 600;
    font-size: 15px;
  }
  dt:first-child {
    margin-top: 0;
  }
  dd {
    margin: 2px 0 0;
    color: var(--dim);
    font-size: 15px;
  }
  @media (max-width: 960px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .flip > :first-child {
      order: 0;
    }
  }
</style>
