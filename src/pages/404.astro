<style>
  main {
    min-height: 100svh;
    display: grid;
    place-content: center;
    text-align: center;
  }
  h1 {
    margin: 0;
    font-size: 4rem;
    letter-spacing: -0.04em;
  }
  a {
    color: var(--accent);
  }
</style>
