{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botropolis-city",
  "compatibility_date": "2026-09-25",
  "send_metrics": false,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false
}
